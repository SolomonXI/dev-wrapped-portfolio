{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "routes": [
    {
      "src": "^/admin(?:/.*)?$",
      "dest": "/api/studio"
    },
    {
      "src": "^/lib(?:/.*)?$",
      "dest": "/api/not-found"
    },
    {
      "src": "^/admin_dashboard_updated(?:/.*)?$",
      "headers": {
        "Location": "/admin/"
      },
      "status": 307
    },
    {
      "src": "^/admin_login_mfa(?:/.*)?$",
      "headers": {
        "Location": "/admin/"
      },
      "status": 307
    },
    {
      "src": "^/admin_manage_certificates(?:/.*)?$",
      "headers": {
        "Location": "/admin/"
      },
      "status": 307
    },
    {
      "src": "^/admin_manage_experience(?:/.*)?$",
      "headers": {
        "Location": "/admin/"
      },
      "status": 307
    },
    {
      "src": "^/admin_manage_projects(?:/.*)?$",
      "headers": {
        "Location": "/admin/"
      },
      "status": 307
    },
    {
      "src": "^/admin_manage_skills(?:/.*)?$",
      "headers": {
        "Location": "/admin/"
      },
      "status": 307
    },
    {
      "src": "^/your_dev_wrapped_dashboard_with_shader(?:/.*)?$",
      "headers": {
        "Location": "/"
      },
      "status": 308
    },
    {
      "src": "^/dev_wrapped(?:/.*)?$",
      "headers": {
        "Location": "/"
      },
      "status": 308
    },
    {
      "src": "^/nova_dashboard_details(?:/.*)?$",
      "headers": {
        "Location": "/featured_projects_wrapped_visual/"
      },
      "status": 308
    },
    {
      "handle": "filesystem"
    }
  ],
  "functions": {
    "api/studio.js": {
      "includeFiles": "lib/studio.html"
    },
    "api/content.js": {
      "includeFiles": "data/site.json"
    }
  }
}
